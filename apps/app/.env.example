# Copy to .env.local and adjust as needed.
# This file is safe to commit. .env.local is gitignored by Vite.

# Base URL for the Better Auth client. Leave unset to use the current origin
# (correct for the bundled deploy where SPA + API share a domain). In split
# local dev this defaults to the Vite origin (http://localhost:5173).
# VITE_APP_URL=http://localhost:5173

# Override the API target for the Vite dev proxy (defaults to the standalone
# API on http://127.0.0.1:8080).
# VITE_API_DEV_TARGET=http://127.0.0.1:8080
