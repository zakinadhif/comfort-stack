# Never copy host dependencies/build output into the image — the deps stage
# installs Linux-native modules that `COPY . .` would otherwise clobber.
**/node_modules
**/dist
**/.astro
**/.turbo

# VCS & tooling
.git
.github
.husky

# Local env / secrets
**/.env
**/.env.*
!**/.env.example
deploy/.env

# Editor / OS cruft
**/.DS_Store
**/*.log

# Tests & docs not needed in the image build
**/playwright-report
**/test-results
**/coverage

# Generated client code is regenerated by `pnpm codegen` during the build
libs/api-client-react/src/generated
libs/api-zod/src/generated
