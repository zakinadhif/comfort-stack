# =============================================================================
# Canonical environment reference for Comfort Stack.
#
# Every variable the app reads is listed here. In production set these via your
# platform's secret manager (fly secrets / Railway / Render / Cloud Run secrets)
# or, for self-hosted compose, copy this file to deploy/.env and fill it in.
#
# Validated at startup by libs/config — the app fails fast on missing/invalid
# values.
# =============================================================================

# --- Core ---------------------------------------------------------------------
NODE_ENV=production
# Port the Hono server listens on. 8080 is the convention across all manifests.
PORT=8080
# Public origin the app is served from (used for auth callbacks and links).
APP_URL=https://example.com

# --- Database (Postgres) ------------------------------------------------------
# Standard Postgres connection string. Same value whether it's Neon, Supabase,
# Cloud SQL, or a self-hosted Postgres — no code change to switch.
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Object storage (S3-compatible) -------------------------------------------
# One adapter, four providers. The only knobs that vary are STORAGE_ENDPOINT
# and STORAGE_FORCE_PATH_STYLE. See deploy/docs/STORAGE_PROVIDERS.md.
# Optional as a group: omit all of these to run without object storage.
#
#   Cloudflare R2 : STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com  REGION=auto   PATH_STYLE=false
#   Backblaze B2  : STORAGE_ENDPOINT=https://s3.<region>.backblazeb2.com         REGION=<rgn>  PATH_STYLE=false
#   AWS S3        : STORAGE_ENDPOINT=(omit)                                      REGION=<rgn>  PATH_STYLE=false
#   MinIO         : STORAGE_ENDPOINT=http://minio:9000                           REGION=us-east-1 PATH_STYLE=true
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_FORCE_PATH_STYLE=false

# --- Auth (Better Auth) -------------------------------------------------------
# Must be at least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Defaults to APP_URL when unset.
BETTER_AUTH_URL=
# Google OAuth (optional — leave blank to disable the Google provider).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- CORS ---------------------------------------------------------------------
# Comma-separated allowlist of browser origins. Defaults to APP_URL when unset.
ALLOWED_ORIGINS=

# --- Self-hosted compose only -------------------------------------------------
# Used by deploy/docker-compose.selfhost.yml for Caddy + Postgres + MinIO.
APP_DOMAIN=example.com
POSTGRES_PASSWORD=change-me
# Optionally pin a prebuilt image instead of building from source:
# APP_IMAGE=ghcr.io/<owner>/comfort-stack:latest
